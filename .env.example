# WeatherPro environment configuration
# Copy to .env and fill in your values.

# OpenWeatherMap API key (required for current weather, search and air quality)
OPENWEATHER_API_KEY=

# Port for the Express backend (default: 3002)
PORT=3002

# Optional: override cache TTL for all API responses in milliseconds.
# When unset, defaults are used (weather 10min, forecast 30min, air 1h, geocode 24h, premium 1h).
# Set to 0 to keep defaults explicit. Example: 600000 = 10 minutes for everything.
CACHE_TTL_MS=0

# Optional: AI assistant. Without a key, WeatherPro uses deterministic rule-based guidance.
# Supported: OpenAI-compatible chat completions endpoints.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional: Paystack live payments. Without this, plan upgrades use local demo mode.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5174/?billing=verify

# Optional: forward triggered custom alerts to your own email/SMS/push bridge.
NOTIFICATION_WEBHOOK_URL=
