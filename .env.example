# WeatherPro environment configuration
# Copy to .env and fill in your values.

# OpenWeatherMap API key (required) — https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Port for the Express backend (default: 3002)
PORT=3002

# Optional: override cache TTL for all API responses in milliseconds.
# When unset, defaults are used (weather 10min, forecast 30min, air 1h, geocode 24h).
# Set to 0 to keep defaults explicit. Example: 600000 = 10 minutes for everything.
CACHE_TTL_MS=0