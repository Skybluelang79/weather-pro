# WeatherPro environment configuration
# Copy to .env and fill in your values.

# OpenWeatherMap API key (required for current weather, search and air quality)
OPENWEATHER_API_KEY=

# Port for the Express backend (default: 3002)
PORT=3002

# Required in production: signs the server-issued subscriber cookie.
SESSION_SECRET=replace-with-a-long-random-value

# Allowed browser origin for credentialed API requests.
ALLOWED_ORIGIN=http://localhost:5174

# Set to true only if demo upgrades must remain available alongside Paystack.
ALLOW_DEMO_UPGRADES=false

# Optional: override cache TTL for all API responses in milliseconds.
# When unset, defaults are used (weather 10min, forecast 30min, air 1h, geocode 24h, premium 1h).
# Set to 0 to keep defaults explicit. Example: 600000 = 10 minutes for everything.
CACHE_TTL_MS=0

# Optional: AI assistant. Without a key, WeatherPro uses deterministic rule-based guidance.
# Supported: OpenAI-compatible chat completions endpoints.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional: Paystack live payments. Without this, plan upgrades use local demo mode.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5174/?billing=verify

# Optional: forward triggered custom alerts to your own bridge.
NOTIFICATION_WEBHOOK_URL=

# Required for password reset emails; also used for custom alert email delivery.
RESEND_API_KEY=
ALERT_EMAIL_FROM=WeatherPro <alerts@yourdomain.com>
ALERT_EMAIL_TO=you@example.com

# Optional: Twilio SMS delivery for custom alerts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
ALERT_SMS_TO=+1234567890

# Optional: web push delivery. Generate a VAPID key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
